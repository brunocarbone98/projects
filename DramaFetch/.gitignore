# DramaFetch — Python tool. The venv, caches and everything downloaded stay local.
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
downloads/
.dramafetch/
# TikTok session cookies under any exporter's name (cookies.txt, www.tiktok.com_cookies.txt, …)
*cookies*.txt
# --dump-raw output (anchored, so a future tests/fixtures/raw/ is not ignored)
/raw/
