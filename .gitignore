# Root-level ignores. Each project keeps its own .gitignore
# (e.g. FullStackHub/.gitignore covers the monorepo subtree).
node_modules/
.turbo/
.DS_Store
*.log

# Editor / IDE settings (machine-specific, not project config)
.idea/
.vscode/

# Claude Code: personal overrides stay local (the committed .claude/settings.json is project config)
.claude/settings.local.json
**/.claude/settings.local.json
CLAUDE.local.md
